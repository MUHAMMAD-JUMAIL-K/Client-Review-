# Serverless AI Configuration Example
# Copy this file to .env or set variables in your Vercel / Netlify / Cloudflare dashboard

# AI Provider: 'openai' or 'gemini'
AI_PROVIDER=openai

# Secret API Key (NEVER expose to the browser!)
AI_API_KEY=your_secret_api_key_here

# Optional model override (Defaults: gpt-4o-mini for OpenAI, gemini-1.5-flash for Gemini)
AI_MODEL=gpt-4o-mini
